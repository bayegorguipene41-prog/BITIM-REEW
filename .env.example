# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Required for Auth.js to work on different hosts
AUTH_TRUST_HOST=true

# Security: allowlist of trusted origins (comma separated, scheme://host[:port]).
# localhost and 127.0.0.1 are always allowed in dev. Add your production origin,
# e.g. https://bitim-reew.vercel.app, otherwise the auth host check will reject it.
AUTH_ALLOWED_ORIGINS=

# Google OAuth credentials (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID)
# If left empty, Google sign-in will be hidden from the UI
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# PostgreSQL connection string (e.g. Vercel Postgres, Neon, Supabase).
# If set, user accounts (register/login) are persisted to Postgres (serverless-safe).
# If empty, BITIM falls back to the local MVP file store in .data/ (NOT serverless-safe,
# single instance only). Set this in staging/production.
DATABASE_URL=

# Upstash Redis (REST) for distributed rate limiting.
# Required for production/serverless rate limiting (shared across instances).
# Set BOTH to enable the Upstash backend; leave empty to use the single-instance
# in-memory fallback (local dev only — NOT serverless-safe).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
